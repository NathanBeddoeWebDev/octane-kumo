---
import { catalog } from "../../catalog";
import "octane-kumo/styles/standalone";

export function getStaticPaths() {
  return catalog.map((entry) => ({ params: { scenario: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
---
<!doctype html>
<html lang="en" data-mode="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{entry.title} — Kumo comparison</title>
  </head>
  <body>
    <a class="skip" href="#comparison">Skip to comparison</a>
    <header class="masthead">
      <a class="brand" href="/">Kumo <span>Component comparison</span></a>
      <span class="pill">React → Octane</span>
    </header>
    <div class="layout">
      <aside>
        <nav aria-label="Component groups">
          <h2>Explore components</h2>
          {catalog.map((item) => (
            <a href={`/compare/${item.id}/`} aria-current={item.id === entry.id ? "page" : undefined}>
              {item.title}
            </a>
          ))}
        </nav>
        <p class="sidebar-note">14 shared scenarios.<br />Charts are deferred.</p>
      </aside>
      <main id="comparison">
        <div class="intro">
          <p class="eyebrow">Native port workbench</p>
          <h1>{entry.title}</h1>
          <p>{entry.description}</p>
          <p class="components">{entry.components}</p>
        </div>
        <div class="controls" aria-label="Preview settings">
          <div class="setting">
            <label for="theme">Theme</label>
            <select id="theme"><option value="light">Light</option><option value="dark">Dark</option></select>
          </div>
          <div class="setting">
            <label for="width">Preview width</label>
            <select id="width"><option value="fluid">Fill panel</option><option value="390">Mobile · 390px</option><option value="768">Tablet · 768px</option></select>
          </div>
          <button id="reset" type="button">Reset both previews</button>
          <span id="status" role="status">Independent demo state</span>
        </div>
        <div class="previews">
          {["react", "octane"].map((runtime) => (
            <section aria-label={`${runtime === "react" ? "React" : "Octane"} preview`}>
              <div class="panel-heading">
                <div><h2>{runtime === "react" ? "React" : "Octane"}</h2><p>{runtime === "react" ? "Pinned upstream reference" : "Native implementation"}</p></div>
                <a data-preview-link href={`/preview/${runtime}/${entry.id}/`} target="_blank" rel="noreferrer">Open alone ↗</a>
              </div>
              <div class="canvas">
                <iframe id={runtime} title={`${runtime === "react" ? "React" : "Octane"}: ${entry.title}`} src={`/preview/${runtime}/${entry.id}/`} allow="clipboard-read; clipboard-write"></iframe>
              </div>
            </section>
          ))}
        </div>
        <div class="note"><h2>Comparison notes</h2><p>{entry.note}</p></div>
        <footer>Same scenario source, separate documents and runtimes. Interact with each side independently; scroll inside a preview for longer examples. This workbench is not an automated parity verdict or an SSR test.</footer>
      </main>
    </div>
    <script>
      const theme = document.querySelector<HTMLSelectElement>("#theme")!;
      const width = document.querySelector<HTMLSelectElement>("#width")!;
      const frames = [...document.querySelectorAll<HTMLIFrameElement>("iframe")];
      const links = [...document.querySelectorAll<HTMLAnchorElement>("[data-preview-link]")];
      const query = new URLSearchParams(location.search);
      theme.value = query.get("mode") === "dark" ? "dark" : "light";
      width.value = ["390", "768"].includes(query.get("width") ?? "") ? query.get("width")! : "fluid";

      function applySettings() {
        document.documentElement.dataset.mode = theme.value;
        document.documentElement.style.colorScheme = theme.value;
        for (const frame of frames) {
          frame.style.width = width.value === "fluid" ? "100%" : `${width.value}px`;
          const root = frame.contentDocument?.documentElement;
          if (root) {
            root.dataset.mode = theme.value;
            root.style.colorScheme = theme.value;
          }
        }
        for (const link of links) {
          const url = new URL(link.href);
          url.searchParams.set("mode", theme.value);
          link.href = url.href;
        }
        const url = new URL(location.href);
        url.searchParams.set("mode", theme.value);
        url.searchParams.set("width", width.value);
        history.replaceState(null, "", url);
        for (const link of document.querySelectorAll<HTMLAnchorElement>("nav a")) {
          const target = new URL(link.href);
          target.search = url.search;
          link.href = target.href;
        }
      }
      frames.forEach((frame) => frame.addEventListener("load", applySettings));
      theme.addEventListener("change", applySettings);
      width.addEventListener("change", applySettings);
      document.querySelector("#reset")!.addEventListener("click", () => {
        frames.forEach((frame) => {
          const url = new URL(frame.src);
          url.searchParams.set("mode", theme.value);
          frame.src = url.href;
        });
        document.querySelector("#status")!.textContent = "Both previews reset";
      });
      applySettings();
    </script>
  </body>
</html>
<style>
  :global(body) { margin: 0; font: 14px/1.5 ui-sans-serif, system-ui, sans-serif; color: var(--text-color-kumo-default); background: var(--color-kumo-base); }
  :global(*) { box-sizing: border-box; }
  a { color: inherit; text-decoration: none; }
  a:hover { color: var(--text-color-kumo-link); }
  :is(a, button, select):focus-visible { outline: 2px solid var(--color-kumo-brand); outline-offset: 3px; }
  h1, h2, p { margin: 0; }
  h1 { font-size: 28px; font-weight: 600; margin: 4px 0 8px; }
  h2 { font-size: 14px; font-weight: 600; }
  .skip { position: absolute; top: -80px; padding: 12px 20px; background: var(--color-kumo-base); z-index: 10; }
  .skip:focus { top: 0; }
  .masthead { display: flex; align-items: center; justify-content: space-between; padding: 16px 28px; border-bottom: 1px solid var(--color-kumo-line); }
  .brand { font-size: 20px; font-weight: 600; display: flex; align-items: center; gap: 20px; }
  .brand span { font-size: 14px; font-weight: 400; color: var(--text-color-kumo-subtle); }
  .pill { padding: 3px 10px; border-radius: 6px; background: var(--color-kumo-tint); color: var(--text-color-kumo-subtle); }
  .layout { display: grid; grid-template-columns: 224px minmax(0, 1fr); }
  aside { padding: 24px 16px; border-right: 1px solid var(--color-kumo-line); }
  nav { display: grid; gap: 3px; }
  nav h2 { padding: 0 12px 12px; }
  nav a { padding: 7px 12px; border-radius: 6px; color: var(--text-color-kumo-subtle); }
  nav a:hover { background: var(--color-kumo-tint); }
  nav a[aria-current] { background: var(--color-kumo-tint); color: var(--text-color-kumo-default); font-weight: 500; box-shadow: inset 3px 0 var(--color-kumo-brand); }
  .sidebar-note { margin: 28px 12px; color: var(--text-color-kumo-subtle); }
  main { min-width: 0; padding: 28px; }
  .intro > p { color: var(--text-color-kumo-subtle); }
  .eyebrow { font-weight: 500; }
  .components { margin-top: 12px; }
  .controls { display: flex; flex-wrap: wrap; gap: 16px; align-items: end; margin: 24px 0 20px; }
  .setting { display: grid; gap: 6px; }
  label { font-weight: 500; }
  select, button { font: inherit; color: var(--text-color-kumo-default); background: var(--color-kumo-base); border: 1px solid var(--color-kumo-line); border-radius: 6px; padding: 6px 10px; height: 36px; }
  button { cursor: pointer; }
  button:hover { background: var(--color-kumo-tint); }
  #status { color: var(--text-color-kumo-subtle); padding-bottom: 7px; }
  .previews { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; }
  section { min-width: 0; border-radius: 10px; overflow: hidden; box-shadow: 0 0 0 1px var(--color-kumo-line), 0 2px 4px var(--color-kumo-tint); }
  .panel-heading { display: flex; justify-content: space-between; align-items: center; gap: 12px; padding: 14px 16px; border-bottom: 1px solid var(--color-kumo-line); }
  .panel-heading h2 { font-size: 16px; }
  .panel-heading p { color: var(--text-color-kumo-subtle); }
  .panel-heading a { white-space: nowrap; color: var(--text-color-kumo-link); }
  .canvas { overflow-x: auto; background: var(--color-kumo-recessed); }
  iframe { display: block; width: 100%; height: 620px; border: 0; margin: auto; }
  .note { padding: 16px 20px; margin-top: 24px; border-radius: 8px; background: var(--color-kumo-tint); }
  .note p { margin-top: 4px; color: var(--text-color-kumo-subtle); }
  footer { margin-top: 20px; color: var(--text-color-kumo-subtle); }
  @media (max-width: 1100px) { .previews { grid-template-columns: minmax(0, 1fr); } }
  @media (max-width: 680px) {
    .masthead { padding: 14px 16px; }
    .brand { gap: 10px; }
    .pill { display: none; }
    .layout { grid-template-columns: minmax(0, 1fr); }
    aside { padding: 12px 16px; border-right: 0; border-bottom: 1px solid var(--color-kumo-line); }
    nav { display: flex; overflow-x: auto; }
    nav a { white-space: nowrap; }
    nav h2, .sidebar-note { display: none; }
    main { padding: 20px 16px; }
    .controls { gap: 12px; }
    #status { flex-basis: 100%; }
    .panel-heading { padding: 12px; }
    iframe { height: 560px; }
  }
</style>
