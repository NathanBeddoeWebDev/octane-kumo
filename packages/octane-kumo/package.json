{
  "name": "octane-kumo",
  "version": "0.0.0",
  "private": false,
  "description": "An Octane-native port of Cloudflare's Kumo design system",
  "keywords": [
    "components",
    "design-system",
    "octane",
    "ui"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NathanBeddoeWebDev/octane-kumo.git",
    "directory": "packages/octane-kumo"
  },
  "files": [
    "src",
    "audit",
    "LICENSE",
    "PORTING.md",
    "README.md",
    "UPSTREAM.md",
    "status.json"
  ],
  "type": "module",
  "sideEffects": [
    "*.css",
    "src/styles/*.css"
  ],
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./components/button": {
      "types": "./src/components/button/index.ts",
      "import": "./src/components/button/index.ts",
      "default": "./src/components/button/index.ts"
    },
    "./components/checkbox": {
      "types": "./src/components/checkbox/index.ts",
      "import": "./src/components/checkbox/index.ts",
      "default": "./src/components/checkbox/index.ts"
    },
    "./components/field": {
      "types": "./src/components/field/index.ts",
      "import": "./src/components/field/index.ts",
      "default": "./src/components/field/index.ts"
    },
    "./components/input": {
      "types": "./src/components/input/index.ts",
      "import": "./src/components/input/index.ts",
      "default": "./src/components/input/index.ts"
    },
    "./components/label": {
      "types": "./src/components/label/index.ts",
      "import": "./src/components/label/index.ts",
      "default": "./src/components/label/index.ts"
    },
    "./components/loader": {
      "types": "./src/components/loader/index.ts",
      "import": "./src/components/loader/index.ts",
      "default": "./src/components/loader/index.ts"
    },
    "./components/radio": {
      "types": "./src/components/radio/index.ts",
      "import": "./src/components/radio/index.ts",
      "default": "./src/components/radio/index.ts"
    },
    "./components/switch": {
      "types": "./src/components/switch/index.ts",
      "import": "./src/components/switch/index.ts",
      "default": "./src/components/switch/index.ts"
    },
    "./components/tooltip": {
      "types": "./src/components/tooltip/index.ts",
      "import": "./src/components/tooltip/index.ts",
      "default": "./src/components/tooltip/index.ts"
    },
    "./styles": "./src/styles/kumo.css",
    "./styles/tailwind": "./src/styles/kumo.css",
    "./styles/standalone": "./src/styles/kumo-standalone.css",
    "./styles/theme-kumo": "./src/styles/theme-kumo.css",
    "./styles/theme-fedramp": "./src/styles/theme-fedramp.css"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev:visual": "vite --host 127.0.0.1 --open /tests/visual/",
    "sync:styles": "node scripts/sync-styles.mjs",
    "test": "vp test run",
    "typecheck": "tsrx-tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@octanejs/base-ui": "0.1.48",
    "@octanejs/phosphor-icons": "0.0.30",
    "cnfast": "^0.0.8"
  },
  "devDependencies": {
    "@octanejs/testing-library": "0.1.47",
    "@tsrx/typescript-plugin": "0.3.128",
    "happy-dom": "catalog:",
    "octane": "0.1.50",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "octane": "0.1.50"
  },
  "engines": {
    "node": "^24.12.0"
  },
  "octane": {
    "hookSlots": {
      "manual": [
        "src"
      ]
    }
  }
}
